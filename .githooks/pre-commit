#!/bin/sh
# T100 — main 직접 커밋 거부.
#
# 왜 훅인가: docs/GitWorkflow.md는 "No direct commits to main"을 이미 규칙으로 적어 뒀는데도
# T15·T82·T83·T84·T85·T86 6건 + 2026-07-26 세션 2건에서 반복해서 위반됐다. 실측 결과 저장소에
# 활성 훅이 0개(.git/hooks는 14개 전부 .sample, core.hooksPath 미설정)라, 그 규칙은 문서상
# 규칙일 뿐 강제된 적이 없다. 이 훅이 "규칙은 있는데 강제가 없다"를 닫는다.
#
# 왜 .git/hooks가 아니라 .githooks인가: .git/ 아래는 버전 관리가 안 돼 새 clone·새 개발자에게
# 전파되지 않는다. 여기 두고 core.hooksPath로 가리키면 파일이 저장소를 따라다닌다.
# 설치(clone당 1회): git config core.hooksPath .githooks
#
# ⚠️ 한계(정직 고지): 이 훅은 `git commit --no-verify`로 우회된다. 로컬 훅은 실수 방지용이지
# 강제 수단이 아니다. 우회 불가능한 강제는 GitHub 브랜치 보호 규칙(서버측)뿐이다 —
# docs/GitWorkflow.md의 T100 절 참고.

protected_branches="main master"

branch="$(git symbolic-ref --short -q HEAD)" || exit 0  # detached HEAD(rebase·bisect 등)는 통과

for protected in $protected_branches; do
	if [ "$branch" = "$protected" ]; then
		printf '\n\033[31m✖ %s 브랜치에 직접 커밋할 수 없습니다.\033[0m\n' "$branch" >&2
		printf '\n  docs/GitWorkflow.md: 모든 변경은 브랜치 → PR → 병합을 거칩니다.\n' >&2
		printf '  이 훅은 T100으로 도입됐습니다 — 같은 사고가 8번 반복돼서입니다.\n' >&2
		printf '\n  지금 변경분을 살리려면:\n' >&2
		printf '    git switch -c <브랜치이름>\n' >&2
		printf '    git commit ...\n' >&2
		printf '\n  (에이전트라면: 지시받은 브랜치가 맞는지 먼저 확인하십시오.\n' >&2
		printf '   공유 저장소를 다른 에이전트가 갈아탔을 수 있습니다.)\n\n' >&2
		exit 1
	fi
done

exit 0
